diff --git a/assets/css/custom.css b/assets/css/custom.css
new file mode 100644
index 0000000..51b14ac
--- /dev/null
+++ b/assets/css/custom.css
@@ -0,0 +1,168 @@
+/* ===== Intestazione ===== */
+body > header {
+  flex-direction: column;
+  align-items: center;
+  padding: 15px 20px 0;
+  margin-bottom: 0;
+}
+
+.site-nav {
+  display: flex;
+  justify-content: center;
+  gap: 30px;
+  width: 100%;
+  margin-bottom: 45px;
+
+  a {
+    padding-left: 2px;
+    font-size: 0.95rem;
+    font-weight: 500;
+    letter-spacing: 2px;
+    text-transform: uppercase;
+
+    &[aria-current="page"] {
+      padding-bottom: 3px;
+      border-bottom: 2px solid currentColor;
+    }
+  }
+}
+
+.header-row {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  width: 100%;
+
+  > :first-child {
+    display: flex;
+    flex: 1;
+    justify-content: flex-start;
+  }
+
+  > .logo {
+    display: flex;
+    flex: 2;
+    justify-content: center;
+  }
+
+  > :last-child {
+    flex: 1;
+  }
+
+  .logo img {
+    width: 240px;
+    max-width: 100%;
+    height: auto;
+  }
+}
+
+hgroup {
+  align-items: center;
+  width: 100%;
+  margin: 30px auto;
+
+  h1 {
+    margin: 0;
+    padding: 0;
+    font-size: 1.6rem;
+    font-weight: 500;
+    text-align: center;
+  }
+}
+
+/* ===== Immagini: nessun trascinamento/selezione (deterrente leggero) ===== */
+img {
+  -webkit-touch-callout: none;
+  -webkit-user-drag: none;
+  user-select: none;
+}
+
+/* ===== Accessibilità: focus visibile da tastiera ===== */
+a:focus-visible,
+button:focus-visible {
+  outline: 2px solid currentColor;
+  outline-offset: 3px;
+}
+
+/* ===== Footer: copyright centrato anche quando va a capo ===== */
+body > footer section:last-of-type {
+  text-align: center;
+}
+
+/* ===== Invito al contatto ===== */
+.cta {
+  max-width: 768px;
+  margin: 4rem auto 3rem;
+  text-align: center;
+
+  p {
+    margin-bottom: 1.25rem;
+    color: var(--text-2);
+    font-size: 1.0625rem;
+    text-wrap: balance;
+  }
+
+  .cta-actions {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    gap: 0.75rem;
+  }
+
+  .cta-btn {
+    padding: 0.75rem 1.5rem;
+    border: 1px solid var(--text-1);
+    border-radius: 9999px;
+    background: var(--text-1);
+    color: var(--surface-1);
+    font-size: 0.95rem;
+    font-weight: 500;
+
+    &--ghost {
+      background: transparent;
+      color: var(--text-1);
+    }
+
+    &:hover {
+      opacity: 0.85;
+    }
+  }
+}
+
+/* ===== Lightbox: fascia per il titolo della foto (usata solo se la foto ha un titolo) ===== */
+.pswp__portfolio-title {
+  position: absolute;
+  bottom: 0;
+  left: 0;
+  width: 100%;
+  height: 60px; /* Deve coincidere esattamente con il paddingFn del JS */
+  
+  /* Flexbox per centrare il testo verticalmente e orizzontalmente */
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  text-align: center;
+  
+  font-family: system-ui, -apple-system, sans-serif;
+  font-size: 0.95rem;
+  font-weight: 400;
+  color: rgba(255, 255, 255, 0.9);
+  letter-spacing: 0.5px;
+  padding: 0 20px;
+  box-sizing: border-box;
+  
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  
+  pointer-events: none;
+  z-index: 100;
+}
+
+/* Sincronizzazione per smartphone */
+@media (max-width: 600px) {
+  .pswp__portfolio-title {
+    height: 50px; /* Sincronizzato con i 50px del paddingFn mobile */
+    font-size: 0.85rem;
+  }
+}
\ No newline at end of file
