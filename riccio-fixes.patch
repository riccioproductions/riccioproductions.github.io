diff --git a/layouts/partials/album-card.html b/layouts/partials/album-card.html
new file mode 100644
index 0000000..614e74f
--- /dev/null
+++ b/layouts/partials/album-card.html
@@ -0,0 +1,18 @@
+{{ $gallery := partial "get-gallery.html" . }}
+{{ with $gallery }}
+  <a class="card" href="{{ .page.RelPermalink }}" title="{{ .page.Title }}">
+    <figure style="background-color: {{ .color }}">
+      <img width="{{ .thumbnail.Width }}" height="{{ .thumbnail.Height }}" src="{{ .thumbnail.RelPermalink }}" loading="lazy" decoding="async" alt="{{ .page.Title }}" />
+    </figure>
+    <div>
+      <h2>{{ .page.Title }}</h2>
+      <p>
+        {{ if gt .albumCount 0 }}
+          {{ T "albumCount" (dict "count" (.albumCount | lang.FormatNumber 0) "photoCount" (.imageCount | lang.FormatNumber 0 | lang.Translate "photoCount")) }}
+        {{ else }}
+          {{ T "photoCount" (.imageCount | lang.FormatNumber 0) }}
+        {{ end }}
+      </p>
+    </div>
+  </a>
+{{ end }}
